<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_company_form_moloni" model="ir.ui.view">
        <field name="name">Company Form: add Moloni</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="moloni" string="Moloni">
                    <group>
                        <field name="moloni_client_id" />
                        <field name="moloni_client_secret" password="True" />
                        <field name="moloni_username" />
                        <field name="moloni_password" password="True" />
                        <field name="moloni_company_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
