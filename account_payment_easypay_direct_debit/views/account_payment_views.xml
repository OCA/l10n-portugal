<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_easypay" model="ir.ui.view">
        <field name="name">account.payment.form.easypay</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_easypay_dd_transactions"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not easypay_dd_transaction_count"
                >
                    <field
                        name="easypay_dd_transaction_count"
                        widget="statinfo"
                        string="EasyPay"
                    />
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page
                    name="easypay"
                    string="EasyPay"
                    invisible="not easypay_dd_transaction_count"
                >
                    <field name="easypay_dd_transaction_ids" nolabel="1">
                        <list>
                            <field name="reference" />
                            <field name="easypay_transaction_id" />
                            <field name="mandate_id" />
                            <field name="state" widget="badge" />
                            <field name="last_state_change" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
