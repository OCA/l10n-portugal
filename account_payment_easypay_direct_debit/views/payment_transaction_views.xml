<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_transaction_form_easypay_dd" model="ir.ui.view">
        <field name="name">payment.transaction.form.easypay.dd</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <field name="token_id" position="after">
                <field name="mandate_id" invisible="not mandate_id" />
                <field name="payment_order_id" invisible="not payment_order_id" />
            </field>
        </field>
    </record>
    <record id="action_easypay_transaction" model="ir.actions.act_window">
        <field name="name">EasyPay Transactions</field>
        <field name="res_model">payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('provider_code', '=', 'easypay')]</field>
    </record>
    <menuitem
        id="easypay_transaction_menu"
        parent="account.menu_finance_receivables"
        action="action_easypay_transaction"
        sequence="30"
    />
</odoo>
