<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_l10n_pt_account_invoice" model="ir.ui.view">
        <field name="name">account.move.form.l10n.pt.account.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field
                    name="l10n_pt_vat_adjustment_norm_id"
                    invisible="country_code != 'PT' or move_type not in ('out_refund', 'in_refund')"
                    readonly="state != 'draft'"
                    options="{'no_create': True}"
                    domain="[('out_refunds' if move_type == 'out_refund' else 'in_refunds', '=', True)]"
                />
                <field
                    name="l10n_pt_vat_adjustment_norm_note"
                    nolabel="1"
                    invisible="not l10n_pt_vat_adjustment_norm_id or country_code != 'PT' or move_type not in ('out_refund', 'in_refund')"
                    class="text-muted"
                />
            </xpath>
        </field>
    </record>
</odoo>
