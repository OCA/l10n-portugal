<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_vat_adjustment_norm_view_search" model="ir.ui.view">
        <field name="name">l10n.pt.vat.adjustment.norm.search</field>
        <field name="model">l10n.pt.vat.adjustment.norm</field>
        <field name="arch" type="xml">
            <search string="VAT Adjustment Legal Basis">
                <field name="name" />
                <field name="note" />
            </search>
        </field>
    </record>
    <record id="account_vat_adjustment_norm_view_list" model="ir.ui.view">
        <field name="name">l10n.pt.vat.adjustment.norm.list</field>
        <field name="model">l10n.pt.vat.adjustment.norm</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="note" />
                <field name="out_refunds" />
                <field name="in_refunds" />
            </list>
        </field>
    </record>
    <record id="account_vat_adjustment_norm_view_form" model="ir.ui.view">
        <field name="name">l10n.pt.vat.adjustment.norm.form</field>
        <field name="model">l10n.pt.vat.adjustment.norm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="note" />
                        </group>
                        <group>
                            <field name="out_refunds" />
                            <field name="in_refunds" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="account_vat_adjustment_norm_action" model="ir.actions.act_window">
        <field name="name">VAT Adjustment Legal Basis</field>
        <field name="res_model">l10n.pt.vat.adjustment.norm</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account_vat_adjustment_norm_view_search" />
    </record>
    <menuitem
        id="menu_account_vat_adjustment_norm"
        parent="account.account_account_menu"
        action="account_vat_adjustment_norm_action"
        sequence="35"
    />
</odoo>
