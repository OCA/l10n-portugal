<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">Journal Form: add Invoicexpress</field>
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="l10n_pt_invoice_provider.view_account_journal_form"
        />
        <field name="arch" type="xml">
            <field name="l10n_pt_doc_provider_id" position="after">
                <field name="invoicexpress_provider_code" invisible="1" />
                <field
                    name="invoicexpress_doc_type"
                    invisible="invoicexpress_provider_code != 'invoicexpress'"
                />
                <field
                    name="invoicexpress_account_name"
                    invisible="invoicexpress_provider_code != 'invoicexpress'"
                />
                <field
                    name="invoicexpress_api_key"
                    password="True"
                    groups="account.group_account_manager"
                    invisible="invoicexpress_provider_code != 'invoicexpress'"
                />
                <field
                    name="invoicexpress_template_id"
                    invisible="invoicexpress_provider_code != 'invoicexpress'"
                />
            </field>
        </field>
    </record>
</odoo>
