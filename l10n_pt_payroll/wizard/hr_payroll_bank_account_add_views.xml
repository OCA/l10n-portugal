<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_payroll_bank_account_add_form" model="ir.ui.view">
        <field name="name">hr.payroll.bank.account.add.form</field>
        <field name="model">hr.payroll.bank.account.add</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="version_id" invisible="1" />
                    <group>
                        <field name="acc_number" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_add_bank_account"
                        type="object"
                        string="Add Bank Account"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
