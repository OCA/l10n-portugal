<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_salary_rule_view_form_l10n_pt" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.l10n.pt</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="payroll.hr_salary_rule_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='rules']" position="before">
                <page string="Portugal" name="l10n_pt">
                    <group>
                        <group string="IRS">
                            <field name="l10n_pt_irs_taxable" />
                            <field name="l10n_pt_dmr_at_role" />
                            <field
                                name="l10n_pt_dmr_code"
                                invisible="l10n_pt_dmr_at_role and l10n_pt_dmr_at_role != 'income'"
                            />
                            <field
                                name="l10n_pt_dmr_at_recipient_nipc"
                                invisible="l10n_pt_dmr_at_role != 'contribution'"
                            />
                        </group>
                        <group string="Social Security">
                            <field name="l10n_pt_ss_nature_code" />
                            <field name="l10n_pt_ss_contribution_base" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
