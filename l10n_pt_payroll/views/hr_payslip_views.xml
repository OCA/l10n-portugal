<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.l10n.pt.payroll</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <field name="date_to" position="after">
                <field name="payment_date" readonly="state in ('done', 'cancel')" />
            </field>
        </field>
    </record>
</odoo>
