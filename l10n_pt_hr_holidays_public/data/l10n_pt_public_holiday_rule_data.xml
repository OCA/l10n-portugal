<odoo noupdate="1">
    <record id="public_holiday_rule_new_year" model="l10n.pt.public.holiday.rule">
        <field name="name">New Year's Day</field>
        <field name="mandatory" eval="True" />
        <field name="sequence" eval="10" />
        <field name="rule_type">fixed</field>
        <field name="month" eval="1" />
        <field name="day" eval="1" />
    </record>
    <record id="public_holiday_rule_good_friday" model="l10n.pt.public.holiday.rule">
