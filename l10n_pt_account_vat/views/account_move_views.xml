<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_l10n_pt_account_vat" model="ir.ui.view">
        <field name="name">account.move.form.l10n.pt.account.vat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field
                    name="l10n_pt_legacy_vat_exemption_code"
                    invisible="not l10n_pt_legacy_vat_exemption_code"
                />
            </xpath>
        </field>
    </record>
</odoo>
