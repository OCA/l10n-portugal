<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- TODO: also add to the Credit Note wizard -->
    <record id="account_invoice_form" model="ir.ui.view">
        <field name="name">Invoice: add l10_pt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <data>
                <!-- Add the VAT Adjustment Norm (Fields 40/41 of the VAT Statement) -->
                <div name="journal_div" position="after">
                    <field name="move_type" invisible="1" />
                    <field name="is_l10npt_vat_enabled" invisible="1" />
                    <field
                        name="l10npt_vat_exempt_reason"
                        invisible="not is_l10npt_vat_enabled"
                    />
                    <field
                        name="vat_adjustment_norm_id"
                        invisible="not is_l10npt_vat_enabled or move_type not in ['out_refund', 'in_refund']"
                        domain="[('move_type', '=', move_type)]"
                    />
                    <field
                        name="vat_adjustment_norm_note"
                        nolabel="1"
                        invisible="not vat_adjustment_norm_id"
                        class="text-muted"
                    />
                </div>
            </data>
        </field>
    </record>
</odoo>
