<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pt_invoice_api</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="journal_id" position="before">
                <field name="journal_type" invisible="1" />
                <field name="l10n_pt_doc_enabled" invisible="1" />
                <field name="l10n_pt_doc_email_enabled" invisible="1" />
                <field name="l10n_pt_doc_id" invisible="1" />
                <field
                    name="l10n_pt_doc_type"
                    invisible="not l10n_pt_doc_enabled"
                    readonly="state != 'draft'"
                />
            </field>
            <header position="inside">
                <button
                    name="action_l10n_pt_send_email"
                    string="Send by Email"
                    type="object"
                    invisible="not l10n_pt_doc_id or not l10n_pt_doc_email_enabled"
                />
                <button
                    name="action_l10n_pt_view_document"
                    string="View Document"
                    type="object"
                    invisible="not l10n_pt_doc_id"
                />
            </header>
        </field>
    </record>
</odoo>
