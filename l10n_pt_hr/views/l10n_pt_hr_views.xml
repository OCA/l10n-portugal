        <field name="name">l10n.pt.collective.contract.form</field>
        <field name="model">l10n.pt.collective.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="l10n_pt_full_time_hours" />
                        <field name="sequence" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_pt_irct_action" model="ir.actions.act_window">
        <field name="name">Collective Contracts</field>
        <field name="res_model">l10n.pt.collective.contract</field>
