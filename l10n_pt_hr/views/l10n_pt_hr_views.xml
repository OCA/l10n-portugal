        <field name="model">l10n.pt.ss.regime</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <field name="name" />
                        <field name="code" />
                        <field name="sequence" />
                        <field name="active" invisible="1" />
                    </group>
                    <group string="Contribution Rates">
                        <group>
                            <field name="l10n_pt_employee_rate" />
                            <field name="l10n_pt_employer_rate" />
                            <field name="l10n_pt_total_rate" />
                        </group>
