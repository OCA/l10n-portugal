<odoo>
    <record id="l10n_pt_irct_list" model="ir.ui.view">
        <field name="name">l10n.pt.collective.contract.list</field>
        <field name="model">l10n.pt.collective.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>
